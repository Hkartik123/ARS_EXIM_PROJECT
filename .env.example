# Environment Mode
NODE_ENV=development

# Server Port & Base URL
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase-hosted PostgreSQL
# Use the pooled Supabase connection string here for the runtime application connection.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Use the direct (non-pooled) connection string for Prisma migrations and schema operations.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Session & JWT Security
JWT_SECRET=
SESSION_COOKIE_NAME=ars_session
COOKIE_MAX_AGE_DAYS=7

# Initial Super Admin (Seeded on first initialization if no admin exists)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Cloudflare Turnstile Anti-Spam
# Test Site Key / Secret Key provided for development (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# S3 / Cloudflare R2 Object Storage (Optional: falls back to local disk storage in development)
STORAGE_PROVIDER=local # local | s3 | r2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ars-exim-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional Email Dispatch (Optional: logs to console if unconfigured in development)
EMAIL_PROVIDER=console # console | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@arsexim.com
SALES_NOTIFY_EMAIL=quotes@arsexim.com

# Telemetry / Monitoring
SENTRY_DSN=
